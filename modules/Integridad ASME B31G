# Función matemática para cálculo de presión remanente (ASME B31G)
def calcular_asme_b31g(maop_bar, d_ext_mm, espesor_mm, smys_mpa, prof_corrosion_mm, long_corrosion_mm):
    if espesor_mm <= 0 or d_ext_mm <= 0:
        return 0.0, 0.0, "Inválido"
    
    d_pct = (prof_corrosion_mm / espesor_mm) * 100.0
    if d_pct > 80:
        return 0.0, 0.0, "RECHAZADO: Profundidad > 80% del espesor nominal"
    
    # Parámetro Folias (A)
    import math
    A = 0.893 * (long_corrosion_mm / math.sqrt(d_ext_mm * espesor_mm))
    
    # Factor de corrección M
    if A <= 4.0:
        M = math.sqrt(1 + 0.6275 * (long_corrosion_mm**2 / (d_ext_mm * espesor_mm)) - 0.00337 * (long_corrosion_mm**4 / (d_ext_mm**2 * espesor_mm**2)))
    else:
        M = 0.032 * (long_corrosion_mm**2 / (d_ext_mm * espesor_mm)) + 3.3
        
    p_falla_bar = ((2 * espesor_mm * (smys_mpa * 10)) / d_ext_mm) * ((1 - (2/3)*(prof_corrosion_mm/espesor_mm)) / (1 - (2/3)*(prof_corrosion_mm/espesor_mm)/M))
    p_safe_bar = p_falla_bar * 0.72  # Factor de seguridad habitual
    
    estado = "APTO PARA OPERAR" if p_safe_bar >= maop_bar else "REQUIERE REPARACIÓN / REBAJA DE PRESIÓN"
    return round(p_falla_bar, 2), round(p_safe_bar, 2), estado

