# FUNCIONES DE CÁLCULO NORMATIVO
# ---------------------------------------------------------
def calcular_espesor_nag100(p_diseno_bar, d_ext_mm, smys_mpa, factor_f, factor_e=1.0, factor_t=1.0):
    p_mpa = p_diseno_bar / 10.0
    s_adm_mpa = smys_mpa * factor_f * factor_e * factor_t
    if s_adm_mpa <= 0:
        return 0.0
    t_requerido_mm = (p_mpa * d_ext_mm) / (2 * s_adm_mpa)
    return round(t_requerido_mm, 2)

def determinar_clase_trazado(viviendas_zona_influencia, es_edificio_alto=False):
    if es_edificio_alto:
        return 4, 0.40
    elif viviendas_zona_influencia <= 10:
        return 1, 0.72
    elif 11 <= viviendas_zona_influencia < 46:
        return 2, 0.60
    else:
        return 3, 0.50

def calcular_prueba_nag124(maop_bar, clase_trazado):
    factores = {1: 1.25, 2: 1.25, 3: 1.40, 4: 1.50}
    factor = factores.get(clase_trazado, 1.40)
    return {
        "factor": factor,
        "p_resistencia": round(maop_bar * factor, 2),
        "p_hermeticidad": round(maop_bar * 1.10, 2)
    }

def verificar_tension_hoop(p_prueba_bar, d_ext_mm, espesor_mm, smys_mpa):
    if espesor_mm <= 0:
        return 0.0, 0.0
    p_mpa = p_prueba_bar / 10.0
    tension_mpa = (p_mpa * d_ext_mm) / (2 * espesor_mm)
    pct_smys = (tension_mpa / smys_mpa) * 100
    return round(tension_mpa, 2), round(pct_smys, 1)

def evaluar_asme_b31g(maop_bar, d_ext_mm, espesor_nom_mm, prof_defecto_mm, longitud_defecto_mm):
    """
    Evaluación de severidad de corrosión según ASME B31G (Original)
    """
    if espesor_nom_mm <= 0 or d_ext_mm <= 0:
        return {}

    pct_profundidad = (prof_defecto_mm / espesor_nom_mm) * 100
    
    # 1. Criterio de profundidad máxima (80% de t)
    if pct_profundidad >= 80.0:
        return {
            "estado": "RECHAZADO",
            "motivo": "Profundidad del defecto >= 80% del espesor nominal. Exige reparación o reemplazo inmediato.",
            "p_safe_bar": 0.0,
            "pct_prof": pct_profundidad,
            "A_factor": 0.0
        }

    # 2. Factor A de longitud geométrica
    A = 0.893 * (longitud_defecto_mm / math.sqrt(d_ext_mm * espesor_nom_mm))
    d_over_t = prof_defecto_mm / espesor_nom_mm

    # 3. Presión Máxima Admisible Reducida (P_safe)
    if A <= 4.0:
        num = 1 - (2/3) * d_over_t
        den = 1 - (2/3) * (d_over_t / math.sqrt(A**2 + 1))
        p_safe = 1.1 * maop_bar * (num / den)
    else:
        p_safe = 1.1 * maop_bar * (1 - d_over_t)

    # Criterio: P_safe no puede superar la MAOP original
    p_safe_final = min(maop_bar, p_safe)

    if p_safe_final >= maop_bar:
        estado = "ACEPTABLE"
        motivo = "El defecto no compromete la MAOP. La cañería es apta para continuar operando."
    else:
        estado = "RELIQUIDEZ / DERATING"
        motivo = f"El defecto reduce la resistencia. Se requiere un Derating operacional a {p_safe_final:.1f} bar o reparación."

    return {
        "estado": estado,
        "motivo": motivo,
        "p_safe_bar": round(p_safe_final, 2),
        "pct_prof": round(pct_profundidad, 1),
        "A_factor": round(A, 3)
    }

